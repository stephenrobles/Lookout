{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lookout reads your calendars so upcoming events can appear on your Apple TV board."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lookout liest deine Kalender, damit anstehende Termine auf deinem Apple TV-Board erscheinen."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lookout reads your reminders so due items can appear on your Apple TV board."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lookout liest deine Erinnerungen, damit fällige Einträge auf deinem Apple TV-Board erscheinen."
          }
        }
      }
    },
    "NSHomeKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lookout lists your HomeKit cameras and accessories so you can choose which ones the Apple TV board shows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lookout listet deine HomeKit-Kameras und -Geräte auf, damit du wählen kannst, welche das Apple TV-Board zeigt."
          }
        }
      }
    }
  }
}