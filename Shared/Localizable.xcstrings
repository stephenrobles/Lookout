    "%@ publishes the calendars and reminders. Change something here or tap Publish now to publish from this %@ instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ veröffentlicht die Kalender und Erinnerungen. Ändere hier etwas oder tippe auf „Jetzt veröffentlichen“, um stattdessen von diesem %2$@ zu veröffentlichen."
          }
        }
      }
    },
